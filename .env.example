# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Venice AI (roleplay chat) — https://venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key_here
# Options: venice-uncensored-role-play | venice-uncensored-1-2
VENICE_MODEL=venice-uncensored-role-play

# AI Horde (images later; optional for now)
AI_HORDE_API_KEY=0000000000

# Optional / unused for roleplay now
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
