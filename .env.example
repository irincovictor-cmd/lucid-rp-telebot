# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter (roleplay chat) — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Auto-picks an available free model. Or set a specific one, e.g. google/gemma-4-31b-it:free
OPENROUTER_MODEL=openrouter/free

# AI Horde (images later; optional for now)
AI_HORDE_API_KEY=0000000000
