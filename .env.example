# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- LLM (roleplay chat) ---
# Prefer DeepSeek when set (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# Optional: deepseek-reasoner
# DEEPSEEK_FALLBACK_MODEL=

# Force provider: deepseek | openrouter (optional; auto-detects from keys)
# LLM_PROVIDER=deepseek

# OpenRouter fallback / alternative — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# AI Horde (images)
AI_HORDE_API_KEY=0000000000
AI_HORDE_MODEL=Nova Anime XL
